# ============================================================
# AI-POWERED RESUME MANAGEMENT SYSTEM - ENVIRONMENT CONFIG
# ============================================================

# Secret key for session security
SECRET_KEY=change-this-in-production-random-secret-key-32chars

# MongoDB Connection URI (Supports local MongoDB or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/resume_management
MONGO_DB_NAME=resume_management

# Storage path for uploaded resumes, candidate folders, and backups
STORAGE_PATH=storage

# Upload configuration (16MB maximum per file)
MAX_CONTENT_LENGTH=16777216

# OpenRouter AI API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=45

# Cookie security
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Application timezone
APPLICATION_TIMEZONE=Asia/Kolkata
